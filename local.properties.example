# Copiá este archivo como `local.properties` y completá los valores.
# local.properties está en .gitignore: NUNCA se commitea.
#
#   cp local.properties.example local.properties

# Ruta del SDK de Android. Android Studio la rellena solo.
sdk.dir=/ruta/a/Android/Sdk


# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings > API
SUPABASE_URL=https://tu-proyecto.supabase.co
# La anon key es pública por diseño: se ofusca en el cliente y la seguridad real
# la dan las políticas RLS (ver supabase/migrations/). NO usar la service_role key.
SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Piloto ──────────────────────────────────────────────────────────────────
# Ciudad del piloto. Define el viewport inicial del mapa y el área de descarga
# de features estáticas de OpenStreetMap.
NOMADSAFE_PILOT_CITY=Trujillo
NOMADSAFE_PILOT_LAT=-8.1116
NOMADSAFE_PILOT_LON=-79.0289
