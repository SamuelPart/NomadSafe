<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícono adaptativo (API 26+, que es nuestro minSdk). Vector puro: no hay PNG
  que regenerar al cambiar la marca, y escala sin pérdida en cualquier densidad.

  El escudo ocupa la zona segura central (72x72dp dentro del canvas de 108dp)
  porque el sistema recorta con máscara circular/cuadrada según el launcher.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Capa monocromática para los íconos temáticos de Android 13+. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
