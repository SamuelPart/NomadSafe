<?xml version="1.0" encoding="utf-8"?>
<!--
  Reglas de extracción para transferencia dispositivo-a-dispositivo (API 31+).
  Mismo criterio que backup_rules.xml: nada de identidad, sesión ni movimiento.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="nomadsafe.db" />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="vosk-model" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="nomadsafe.db" />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="vosk-model" />
    </device-transfer>
</data-extraction-rules>
