    <!-- Mensajes de emergencia enviados a contactos de confianza.
         Van al grano y ponen la acción primero: quien los recibe está asustado y
         tiene segundos. Cualquier preámbulo cortés es daño.
         Ver docs/GROWTH_LOOPS.md y feature/growth/GrowthContent.kt. -->
    <string name="sos_message">🚨 EMERGENCIA: %1$s activó su alerta SOS en NomadSafe.\n\nUbicación: %2$s\nHora: %3$s\nPrecisión: %4$s\n\nLlamá al 105 (PNP) o al 117 si no podés acudir.</string>
    <string name="sos_panic_word_message">🚨 EMERGENCIA: NomadSafe detectó un pedido de auxilio por voz %1$s y activó el SOS automáticamente. Abrí el link para ver la ubicación en vivo.</string>
    <string name="sos_checkin_message">⚠️ ALERTA PREVENTIVA: la persona no respondió la confirmación del Modo Escolta de NomadSafe. Puede ser un falso aviso, pero conviene verificar. Abrí el link para ver su última ubicación.</string>
    <string name="sos_false_alarm_message">✅ Falsa alarma: %1$s confirmó que está bien. Gracias por estar pendiente.</string>

